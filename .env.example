# Copy to .env and fill in. NEVER commit the real .env.
#
# The bot does not read the Telegram token directly: config/fastnews247.sources.json
# declares "tokenEnv"/"channelEnv" and the posting path goes through the
# credential-owning OpenClaw bridge. These names must match that config.

FASTNEWS247_TELEGRAM_BOT_TOKEN=
FASTNEWS247_TELEGRAM_CHANNEL_ID=@fastnews247vn

# Python must not mangle Vietnamese output in logs
PYTHONIOENCODING=utf-8
