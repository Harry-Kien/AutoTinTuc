# Copy to .env and fill in. NEVER commit the real .env.
#
# These names must match "tokenEnv" / "channelEnv" in
# config/fastnews247.sources.json.
#
# The token below is only read when that config sets mode: "direct" (the VPS
# path). Under the default mode: "bridge" the token stays inside OpenClaw and
# this file only needs the channel id.

FASTNEWS247_TELEGRAM_BOT_TOKEN=
FASTNEWS247_TELEGRAM_CHANNEL_ID=@fastnews247vn

# Only needed under mode: "bridge" when OpenClaw is installed somewhere the
# resolver does not look. Point it at the openclaw executable or openclaw.mjs.
# OPENCLAW_CLI=/usr/lib/node_modules/openclaw/openclaw.mjs

# Python must not mangle Vietnamese output in logs
PYTHONIOENCODING=utf-8
